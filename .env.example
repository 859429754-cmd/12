# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BACKUP_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gate.io account slots
# trend: account 1, runs the current ETH trend strategy.
GATEIO_TREND_API_KEY=
GATEIO_TREND_API_SECRET=

# follower: account 2, follows the account-1 strategy signal and one shared DeepSeek decision.
GATEIO_FOLLOWER_API_KEY=
GATEIO_FOLLOWER_API_SECRET=

# range: reserved for a future range/mean-reversion strategy account.
GATEIO_RANGE_API_KEY=
GATEIO_RANGE_API_SECRET=

# Agent Gateway
AGENT_GATEWAY_TOKEN=
AGENT_GATEWAY_SCOPES=R,B

# Console account login / RBAC
# Production default is fail-closed: if auth is not explicitly disabled and no users are configured,
# privileged API routes return console_auth_not_configured.
CONSOLE_AUTH_DISABLED=
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=
CONSOLE_ACCOUNT1_USER=account1
CONSOLE_ACCOUNT1_PASSWORD=
CONSOLE_ACCOUNT2_USER=account2
CONSOLE_ACCOUNT2_PASSWORD=
CONSOLE_RANGE_USER=range
CONSOLE_RANGE_PASSWORD=
CONSOLE_COOKIE_SECURE=1
CONSOLE_CORS_ORIGINS=

# Optional local development only. Never set this on a public cloud console.
# CONSOLE_AUTH_DISABLED=1

# Optional free data APIs
CRYPTOPANIC_API_KEY=
FRED_API_KEY=
