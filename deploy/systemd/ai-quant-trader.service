[Unit]
Description=AI Quant Trader Workers
After=network-online.target ai-quant-console.service
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/root/ai-quant-trader
EnvironmentFile=-/root/ai-quant-trader/.env.runtime
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONMALLOC=malloc
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/ai-quant-trader/current
ExecStart=/root/ai-quant-trader/.venv/bin/python current/main.py
Restart=always
RestartSec=10
WatchdogSec=60
NotifyAccess=main
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
